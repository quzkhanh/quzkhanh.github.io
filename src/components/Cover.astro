---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  shots: { image: ImageMetadata; color: string }[];
}
---

<div class="flex aspect-[3/1] items-start gap-3 overflow-hidden bg-hover px-4 pt-6 md:aspect-[6/1] md:gap-4 md:px-12" aria-hidden="true">
  {Astro.props.shots.map(({ image, color }) => (
    <Image
      src={image}
      alt=""
      widths={[160, 320]}
      quality={60}
      sizes="(min-width: 768px) 12vw, 28vw"
      loading="eager"
      class="h-auto w-[28%] shrink-0 rounded-pin md:w-[12%]"
      style={`background: ${color}`}
    />
  ))}
</div>
