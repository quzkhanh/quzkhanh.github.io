---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  appId: string;
  title: string;
  color: string;
  image: ImageMetadata;
  screen: number;
  index: number;
  video?: string;
}

// Phone screens all share one shape, so pins crop to a rotating set of ratios to get Pinterest's staggered rhythm.
const ASPECTS = ['aspect-[9/16]', 'aspect-[4/5]', 'aspect-[2/3]', 'aspect-square', 'aspect-[3/4]'];
const EAGER_PINS = 6;
const QUALITY = 70;

const { appId, title, color, image, screen, index, video } = Astro.props;
const poster = video && (await getImage({ src: image, width: 320, quality: QUALITY })).src;
---

<li class="self-start pb-4">
  <button type="button" data-open={appId} data-screen={screen} aria-haspopup="dialog" class="group block w-full cursor-zoom-in text-left">
    <span class:list={['relative block overflow-hidden rounded-pin ring-1 ring-black/5', ASPECTS[index % ASPECTS.length]]} style={`background: ${color}`}>
      {video ? (
        <video src={video} data-poster={poster} data-autoplay muted loop playsinline preload="none" class="size-full object-cover object-top" aria-label={`${title} screen recording`}></video>
      ) : (
        <Image
          src={image}
          alt={`${title}, screen ${screen + 1}`}
          widths={[280, 560]}
          sizes="(min-width: 1280px) 18vw, (min-width: 640px) 30vw, 46vw"
          quality={QUALITY}
          loading={index < EAGER_PINS ? 'eager' : 'lazy'}
          class="size-full object-cover object-top"
        />
      )}
      <span class="absolute inset-0 flex items-start justify-end bg-black/0 p-3 transition-colors duration-200 group-hover:bg-black/35">
        <span class="btn btn-primary min-h-10 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">Open</span>
      </span>
    </span>
    <span class="mt-1.5 block truncate px-1 text-step--1 text-muted">{title}</span>
  </button>
</li>
