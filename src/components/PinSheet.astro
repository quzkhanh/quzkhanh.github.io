---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import CaretLeft from '@phosphor-icons/core/assets/bold/caret-left-bold.svg';
import CaretRight from '@phosphor-icons/core/assets/bold/caret-right-bold.svg';
import X from '@phosphor-icons/core/assets/bold/x-bold.svg';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { id, data } = Astro.props.project;
const links = [
  { href: data.store, label: 'Google Play' },
  { href: data.demo, label: 'Live demo' },
  { href: data.repo, label: 'GitHub' },
].filter((link) => link.href);
---

<dialog id={`sheet-${id}`} aria-labelledby={`sheet-${id}-title`} class="sheet m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-sheet overflow-hidden rounded-sheet bg-paper p-0 text-ink">
  <div class="grid max-h-[calc(100dvh-2rem)] md:grid-cols-[1.1fr_1fr]">
    <div data-gallery class="relative" style={`background: ${data.color}`}>
      <div data-track tabindex="0" role="region" aria-label={`${data.title} screens`} class="flex h-[min(70dvh,40rem)] snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-smooth [scrollbar-width:none] motion-reduce:scroll-auto">
        {data.video && (
          <video src={data.video} class="h-full w-full shrink-0 snap-center object-contain" muted loop playsinline preload="none" aria-label={`${data.title} screen recording`}></video>
        )}
        {data.images.map((image, index) => (
          <Image
            src={image}
            alt={`${data.title}, screen ${index + 1} of ${data.images.length}`}
            widths={[400, 800]}
            sizes="(min-width: 768px) 32rem, 100vw"
            class="h-full w-full shrink-0 snap-center object-contain p-6"
          />
        ))}
      </div>
      <button type="button" data-prev aria-label="Previous screen" class="icon-button absolute top-1/2 left-3 -translate-y-1/2 max-md:hidden"><CaretLeft class="size-4" /></button>
      <button type="button" data-next aria-label="Next screen" class="icon-button absolute top-1/2 right-3 -translate-y-1/2 max-md:hidden"><CaretRight class="size-4" /></button>
    </div>

    <div class="flex flex-col gap-5 overflow-y-auto p-6 md:p-8">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          {data.icon && <Image src={data.icon} alt="" width={96} class="size-12 shrink-0 rounded-[28%]" />}
          <h2 id={`sheet-${id}-title`} class="text-step-2 leading-tight font-bold">{data.title}</h2>
        </div>
        <button type="button" data-close aria-label="Close" class="icon-button shrink-0 shadow-none"><X class="size-4" /></button>
      </div>
      <p>{data.summary}</p>
      <dl class="grid grid-cols-[5.5rem_1fr] gap-y-2 text-step--1">
        <dt class="text-muted">Built</dt>
        <dd>Solo, {data.year}</dd>
        <dt class="text-muted">Stack</dt>
        <dd class="flex flex-wrap gap-1.5">{data.tech.map((item) => <span class="tag">{item}</span>)}</dd>
      </dl>
      {links.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-2 pt-2">
          {links.map(({ href, label }, index) => (
            <a href={href} target="_blank" rel="noopener" class:list={['btn', index === 0 ? 'btn-primary' : 'btn-soft']}>{label}</a>
          ))}
        </div>
      )}
    </div>
  </div>
</dialog>
