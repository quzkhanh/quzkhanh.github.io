---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import PageHeader from '../components/PageHeader.astro';
import PinGrid from '../components/PinGrid.astro';
import { site } from '../data/site';

const COVER_SHOTS = 9;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const coverShots = projects
  .flatMap(({ data }) => data.images.map((image) => ({ image, color: data.color })))
  .filter((_, index, all) => index % Math.max(1, Math.floor(all.length / COVER_SHOTS)) === 0)
  .slice(0, COVER_SHOTS);
---

<Base>
  <Cover shots={coverShots} />
  <main>
    <PageHeader />
    <PinGrid projects={projects} />
  </main>
  <footer class="page border-t border-line py-6 text-step--1 text-muted">
    © {new Date().getFullYear()} {site.name}
  </footer>
</Base>
